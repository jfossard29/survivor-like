[sub_resource type="GDScript" id="GDScript_ka6hu"]
script/source = "extends CanvasLayer

@onready var sonde = $PanelContainer/PanelContainer/PanelContainer/MarginContainer/VBoxContainer/Sonde/Value
@onready var aura = $PanelContainer/PanelContainer/PanelContainer/MarginContainer/VBoxContainer/Aura/Value
@onready var bounce = $PanelContainer/PanelContainer/PanelContainer/MarginContainer/VBoxContainer/Bounce/Value
@onready var base = $PanelContainer/PanelContainer/PanelContainer/MarginContainer/VBoxContainer/Base/Value
	
func _on_anim_finished(name_anim: String):
	if name_anim == \"fermer\":
		$AnimationPlayer.play(\"ouvrir\")
		
func setup_win():
	sonde.text = \"%d\" % GameManager.count_manager.probe
	aura.text = \"%.1f\" % GameManager.count_manager.dmg_aura
	bounce.text = \"%.1f\" % GameManager.count_manager.dmg_bounce
	base.text = \"%.1f\" % GameManager.count_manager.dmg_base
	$AnimationPlayer.connect(\"animation_finished\", Callable(self, \"_on_anim_finished\"))
	$AnimationPlayer.play(\"fermer\")
	
"

