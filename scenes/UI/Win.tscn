[sub_resource type="GDScript" id="GDScript_kb7o0"]
script/source = "extends Label

var pulse_speed: float = 2.0
var min_alpha: float = 0.4
var max_alpha: float = 1.0
var t := 0.0

@onready var ls := get_label_settings()

func _process(delta):
	t += delta * pulse_speed

	# interpolation sinusoïdale
	var a = lerp(min_alpha, max_alpha, (sin(t) + 1.0) * 0.5)

	# on modifie uniquement l’alpha du shadow
	var c = ls.shadow_color
	c.a = a
	ls.shadow_color = c
"

