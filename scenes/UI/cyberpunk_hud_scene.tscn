[sub_resource type="GDScript" id="GDScript_4u5li"]
script/source = "extends CanvasLayer

@onready var panel: Panel = $Panel
@onready var health_bar: ProgressBar = $Panel/PV/ProgressBar
@onready var xp_bar: ProgressBar = $Panel/Experience/ProgressBar
@onready var scan_line: ColorRect = $Panel/ScanLine

# Couleurs pour les animations
var neon_cyan := Color(\"#00F5FF\")
var neon_purple := Color(\"#8B00FF\")
var neon_yellow := Color(\"#FFFF00\")
var neon_pink := Color(\"#FF006E\")

# Animation
var pulse_timer := 0.0
var glitch_timer := 0.0

func _ready() -> void:
	_start_scan_line_animation()

func _start_scan_line_animation() -> void:
	var tween = create_tween()
	tween.set_loops()
	tween.tween_property(scan_line, \"position:y\", 120.0, 2.0)
	tween.tween_property(scan_line, \"position:y\", 0.0, 2.0)

func _process(delta: float) -> void:
	pulse_timer += delta * 2.0
	glitch_timer += delta
	
	# Effet de pulsation sur les bordures
	_update_pulse_effect()
	
	# Effet de glitch aléatoire
	if glitch_timer > 3.0 and randf() > 0.95:
		_trigger_glitch_effect()
		glitch_timer = 0.0

func _update_pulse_effect() -> void:
	var pulse = (sin(pulse_timer) + 1.0) / 2.0  # Valeur entre 0 et 1
	
	# Faire pulser la bordure et l'ombre du panel
	var panel_style = panel.get_theme_stylebox(\"panel\")
	if panel_style is StyleBoxFlat:
		var pulse_color = neon_cyan.lerp(neon_purple, pulse)
		panel_style.border_color = pulse_color
		panel_style.shadow_color = Color(pulse_color, 0.5)

func _trigger_glitch_effect() -> void:
	# Créer un effet de glitch temporaire
	var original_pos = panel.position
	panel.position = original_pos + Vector2(randf_range(-3, 3), randf_range(-3, 3))
	
	await get_tree().create_timer(0.05).timeout
	panel.position = original_pos

# Méthodes publiques pour mettre à jour les barres
func update_health(current: float, maximum: float) -> void:
	health_bar.max_value = maximum
	
	# Animation smooth
	var tween = create_tween()
	tween.tween_property(health_bar, \"value\", current, 0.3).set_trans(Tween.TRANS_CUBIC)
	
	# Effet de flash si dégâts critiques
	if current < maximum * 0.3:
		_flash_health_bar()

func update_xp(current: float, maximum: float) -> void:
	xp_bar.max_value = maximum
	
	# Animation smooth
	var tween = create_tween()
	tween.tween_property(xp_bar, \"value\", current, 0.3).set_trans(Tween.TRANS_CUBIC)
	
	# Effet de flash au level up
	if current >= maximum:
		_flash_xp_bar()

func _flash_health_bar() -> void:
	var fill_style = health_bar.get_theme_stylebox(\"fill\")
	if fill_style is StyleBoxFlat:
		var original_color = fill_style.bg_color
		
		var tween = create_tween()
		tween.tween_property(fill_style, \"bg_color\", Color.RED, 0.2)
		tween.tween_property(fill_style, \"bg_color\", original_color, 0.2)

func _flash_xp_bar() -> void:
	var fill_style = xp_bar.get_theme_stylebox(\"fill\")
	if fill_style is StyleBoxFlat:
		var original_color = fill_style.bg_color
		
		var tween = create_tween()
		tween.tween_property(fill_style, \"bg_color\", neon_yellow, 0.2)
		tween.tween_property(fill_style, \"bg_color\", original_color, 0.2)
"

