[sub_resource type="GDScript" id="GDScript_uc0ft"]
script/source = "@tool
extends Node3D

@export var map_size: int = 30:
	set(value):
		map_size = value
		if Engine.is_editor_hint():
			_update_grid()

@export var max_height: int = 5:
	set(value):
		max_height = value
		if Engine.is_editor_hint():
			_update_grid()

@export var bloc_size: float = 10.0

@export var seed: int = 0:
	set(value):
		seed = value
		if Engine.is_editor_hint():
			_update_grid()

@export_group(\"Platform Generation\")
@export_range(0.0, 1.0, 0.01) var platform_coverage: float = 0.15
@export_range(2, 10) var min_platform_size: int = 3
@export_range(5, 20) var max_platform_size: int = 8
@export_range(0, 5) var min_gap: int = 1
@export_range(0.0, 1.0, 0.1) var stacking_chance: float = 0.5
@export var max_attempts: int = 3000

@export_group(\"Debug & Visualization\")
@export var show_grid_in_console: bool = false:
	set(value):
		show_grid_in_console = value
		if value and Engine.is_editor_hint():
			print_grid_to_console()

@export var show_detailed_info: bool = false:
	set(value):
		show_detailed_info = value
		if value and Engine.is_editor_hint():
			print_detailed_info()

@export var generate_platforms: bool = false:
	set(value):
		generate_platforms = false
		if value and Engine.is_editor_hint():
			_generate_platforms()

@export_group(\"3D Generation\")
@export var floor_block_scene: PackedScene
@export var side_block_scene: PackedScene
@export var corner_block_scene: PackedScene
@export var ramp_scene: PackedScene

@export var generate_3d: bool = false:
	set(value):
		generate_3d = false
		if value and Engine.is_editor_hint():
			_generate_3d_map()

var grid: Array = []
var platforms: Array = []
var stats: Dictionary = {
	\"total_cells\": 0,
	\"filled_cells\": 0,
	\"platforms_count\": 0,
	\"max_height_used\": 0
}

func _ready() -> void:
	if Engine.is_editor_hint():
		_update_grid()

func _update_grid() -> void:
	print(\"\\n🔄 Mise à jour de la grille...\")
	_initialize_grid()
	_calculate_stats()
	print(\"✅ Grille initialisée: \", map_size, \"x\", map_size, \"x\", max_height)

func _initialize_grid() -> void:
	if grid.size() != map_size:
		grid.clear()
		for x in range(map_size):
			var column_z = []
			for z in range(map_size):
				var column_y = []
				for y in range(max_height):
					column_y.append(0)
				column_z.append(column_y)
			grid.append(column_z)
	else:
		for x in range(map_size):
			for z in range(map_size):
				for y in range(max_height):
					grid[x][z][y] = 0

func _calculate_stats() -> void:
	stats.total_cells = map_size * map_size * max_height
	stats.filled_cells = 0
	stats.max_height_used = 0
	stats.platforms_count = platforms.size()
	
	for x in range(map_size):
		for z in range(map_size):
			for y in range(max_height):
				if grid[x][z][y] != 0:
					stats.filled_cells += 1
					stats.max_height_used = max(stats.max_height_used, y + 1)

func print_grid_to_console() -> void:
	print(\"\\n═══════════════════════════════════════\")
	print(\"🗺️  VISUALISATION DE LA GRILLE\")
	print(\"═══════════════════════════════════════\")
	print(\"Dimensions: \", map_size, \"x\", map_size, \"x\", max_height)
	print(\"Seed: \", seed)
	print(\"\\nLégende:\")
	print(\"  . = vide\")
	print(\"  0-9 = numéro du niveau Y\")
	print(\"  R = rampe\")
	print(\"═══════════════════════════════════════\\n\")
	
	# N'afficher que jusqu'à la hauteur max utilisée
	var max_display = stats.max_height_used if stats.max_height_used > 0 else 1
	
	for y in range(max_display):
		print(\"--- NIVEAU Y = \", y, \" ---\")
		var header = \"   \"
		for x in range(min(map_size, 50)):
			header += str(x % 10)
		print(header)
		
		for z in range(min(map_size, 50)):
			var line = str(z).pad_zeros(2) + \" \"
			for x in range(min(map_size, 50)):
				var cell = grid[x][z][y]
				
				if cell == 2:
					# Rampe
					line += \"R\"
				elif cell != 0:
					# Plateforme - afficher le niveau Y
					line += str(y)
				elif y > 0 and grid[x][z][y - 1] == 1:
					# Montrer le niveau parent (seulement plateformes)
					# Chercher le niveau du parent
					var parent_y = y - 1
					while parent_y >= 0:
						if grid[x][z][parent_y] == 1:
							line += str(parent_y)
							break
						parent_y -= 1
					if parent_y < 0:
						line += \".\"
				else:
					# Vide
					line += \".\"
			print(line)
		print(\"\")

func print_detailed_info() -> void:
	print(\"\\n╔══════════════════════════════════════╗\")
	print(\"║   INFORMATIONS DÉTAILLÉES            ║\")
	print(\"╚══════════════════════════════════════╝\")
	print(\"Plateformes: \", platforms.size())
	print(\"Cellules remplies: \", stats.filled_cells)
	print(\"Hauteur max utilisée: \", stats.max_height_used)

func _generate_platforms() -> void:
	print(\"\\n🎮 GÉNÉRATION DES PLATEFORMES\")
	_initialize_grid()
	platforms.clear()
	
	var rng = RandomNumberGenerator.new()
	if seed == 0:
		rng.randomize()
	else:
		rng.seed = seed
	
	var config = {
		\"platform_coverage\": platform_coverage,
		\"min_size\": min_platform_size,
		\"max_size\": max_platform_size,
		\"min_gap\": min_gap,
		\"stacking_chance\": stacking_chance,
		\"max_attempts\": max_attempts
	}
	
	platforms = PlatformGeneratorGrid.generate_platforms(grid, map_size, max_height, rng, config)
	_calculate_stats()
	
	# Arrêt si aucune plateforme générée
	if platforms.is_empty():
		print(\"❌ Aucune plateforme générée, arrêt.\")
		return
	
	print_grid_to_console()
	print_detailed_info()

func _generate_3d_map() -> void:
	print(\"\\n🎮 GÉNÉRATION 3D\")
	
	# Vérifier que les plateformes sont générées
	if platforms.is_empty():
		print(\"❌ Aucune plateforme en mémoire. Cliquez d'abord sur 'Generate Platforms'\")
		return
	
	# Vérifier que les scènes sont assignées
	if not floor_block_scene or not side_block_scene or not corner_block_scene or not ramp_scene:
		print(\"❌ Assignez les 4 scènes de blocs dans l'inspecteur (Floor, Side, Corner, Ramp)\")
		return
	
	# Vider TOUS les enfants du node
	_clear_all_children()
	
	# Préparer le dictionnaire de scènes
	var block_scenes = {
		Map3DBuilder.BlockType.FLOOR: floor_block_scene,
		Map3DBuilder.BlockType.SIDE: side_block_scene,
		Map3DBuilder.BlockType.CORNER: corner_block_scene,
		Map3DBuilder.BlockType.RAMP: ramp_scene
	}
	
	# Construire la map 3D
	Map3DBuilder.build_3d_map(
		grid, platforms, map_size, max_height,
		bloc_size, self, block_scenes
	)

func _clear_all_children() -> void:
	print(\"🧹 Suppression de tous les enfants...\")
	var cleared_count = 0
	
	for child in get_children():
		child.queue_free()
		cleared_count += 1
	
	print(\"  ✅ %d objets supprimés\" % cleared_count)
"

