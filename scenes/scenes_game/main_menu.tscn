[sub_resource type="GDScript" id="GDScript_lgwnu"]
script/source = "extends Control

# Configuration de l'opérateur
@export var operator_name: String = \"GHOST RUNNER\"
@export var operator_bio: String = \"Agent infiltré spécialisé dans les opérations furtives en zone hostile. Maîtrise des systèmes cybernétiques avancés et expertise en combat rapproché.\"
@export var base_weapon: String = \"PLASMA PISTOL\"
@export var max_hp: int = 200
@export var xp_multiplier: float = 1.5
@export var damage_multiplier: float = 2.3
@export var harvest_multiplier: float = 1.2
@export var harvest_range: float = 12.5
@export_enum(\"Insignificant\", \"Surveillance\", \"Classified\") var threat_level: int = 2

# Descriptions pour les tooltips
@export_group(\"Descriptions\")
@export_multiline var weapon_description: String = \"Arme de poing à plasma haute fréquence. Dégâts énergétiques modérés avec cadence de tir élevée.\"
@export_multiline var hp_description: String = \"Points de vie maximaux de l'opérateur. Détermine la résistance aux dégâts.\"
@export_multiline var xp_description: String = \"Bonus d'expérience appliqué à toutes les actions. Accélère la progression.\"
@export_multiline var dmg_description: String = \"Multiplicateur de dégâts offensifs. Augmente l'efficacité au combat.\"
@export_multiline var harvest_description: String = \"Multiplicateur de récolte. Augmente la quantité de ressources obtenues.\"

@export_group(\"Tooltip Position\")
@export var tooltip_offset_x: float = 20.0
@export var tooltip_offset_y: float = 20.0

# Couleurs cyberpunk
const COLOR_CYAN := Color(0.0, 0.83, 1.0)
const COLOR_MAGENTA := Color(1.0, 0.0, 1.0)
const COLOR_DARK_BG := Color(0.02, 0.02, 0.06, 0.95)
const COLOR_GREEN := Color(0.29, 0.87, 0.5)
const COLOR_YELLOW := Color(0.98, 0.75, 0.14)
const COLOR_RED := Color(0.94, 0.26, 0.26)

# Références aux nodes
@onready var scan_line: ColorRect = $ScanLine
@onready var operator_name_label: Label = $MainContainer/VBoxContainer/Header/MarginContainer/VBoxContainer/OperatorName
@onready var bio_label: Label = $MainContainer/VBoxContainer/Header/MarginContainer/VBoxContainer/Bio
@onready var weapon_value: Label = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/WeaponRow/MarginContainer/HBoxContainer/WeaponValue
@onready var hp_value: Label = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/HPRow/MarginContainer/HBoxContainer/HPBadge/MarginContainer/HPValue
@onready var xp_value: Label = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/XPRow/MarginContainer/HBoxContainer/XPBadge/MarginContainer/XPValue
@onready var dmg_value: Label = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/DMGRow/MarginContainer/HBoxContainer/DMGBadge/MarginContainer/DMGValue
@onready var harvest_value: Label = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/HarvestRow/MarginContainer/HBoxContainer/HarvestBadge/MarginContainer/HarvestValue
@onready var threat_label: Label = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/ThreatRow/MarginContainer/HBoxContainer/ThreatBadge/MarginContainer/ThreatLabel
@onready var main_container: PanelContainer = $MainContainer
@onready var header: PanelContainer = $MainContainer/VBoxContainer/Header
@onready var footer: PanelContainer = $MainContainer/VBoxContainer/Footer
@onready var hp_badge: PanelContainer = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/HPRow/MarginContainer/HBoxContainer/HPBadge
@onready var xp_badge: PanelContainer = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/XPRow/MarginContainer/HBoxContainer/XPBadge
@onready var dmg_badge: PanelContainer = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/DMGRow/MarginContainer/HBoxContainer/DMGBadge
@onready var harvest_badge: PanelContainer = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/HarvestRow/MarginContainer/HBoxContainer/HarvestBadge
@onready var threat_badge: PanelContainer = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/ThreatRow/MarginContainer/HBoxContainer/ThreatBadge

# Rows pour les bordures
@onready var weapon_row: PanelContainer = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/WeaponRow
@onready var hp_row: PanelContainer = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/HPRow
@onready var xp_row: PanelContainer = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/XPRow
@onready var dmg_row: PanelContainer = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/DMGRow
@onready var harvest_row: PanelContainer = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/HarvestRow
@onready var threat_row: PanelContainer = $MainContainer/VBoxContainer/StatsBody/VBoxContainer/ThreatRow

# Animation
var time := 0.0
var glow_intensity := 0.0
var scan_position := 0.0

# Hover system
var hover_items := {}
var tooltip_panel: PanelContainer
var tooltip_label: Label
var current_hover_item: Control = null
var tooltip_fixed_position: Vector2 = Vector2.ZERO

# Flag pour savoir si tout est initialisé
var is_ready := false

func _ready():
	# Attendre que tous les nodes @onready soient chargés
	await get_tree().process_frame
	
	# Initialiser dans le bon ordre
	update_values()
	apply_threat_style()
	setup_hover_system()
	
	is_ready = true

# Fonction pour charger des données depuis une ressource
func load_player_data(resource_path: String) -> void:
	# Attendre que le script soit complètement prêt
	if not is_ready:
		await get_tree().process_frame
	
	var player_data = load(resource_path)
	if not player_data:
		push_error(\"Impossible de charger la ressource: \" + resource_path)
		return
	
	# Charger les données avec vérification
	if \"name\" in player_data:
		operator_name = player_data.name
	if \"bio\" in player_data:
		operator_bio = player_data.bio
	if \"base_weapon\" in player_data:
		base_weapon = player_data.base_weapon
	if \"hp\" in player_data:
		max_hp = player_data.hp
	if \"xp\" in player_data:
		xp_multiplier = player_data.xp
	if \"dmg\" in player_data:
		damage_multiplier = player_data.dmg
	if \"harvest\" in player_data:
		harvest_multiplier = player_data.harvest
	if \"threat_level\" in player_data:
		threat_level = player_data.threat_level
	
	# Mettre à jour l'affichage
	update_values()
	apply_threat_style()

func setup_hover_system():
	# Création du tooltip à la racine
	tooltip_panel = PanelContainer.new()
	tooltip_panel.visible = false
	tooltip_panel.z_index = 200
	tooltip_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	tooltip_panel.top_level = true
	
	var tooltip_style := StyleBoxFlat.new()
	tooltip_style.bg_color = Color(0.05, 0.05, 0.15, 0.98)
	tooltip_style.border_color = COLOR_CYAN
	tooltip_style.border_width_left = 2
	tooltip_style.border_width_right = 2
	tooltip_style.border_width_top = 2
	tooltip_style.border_width_bottom = 2
	tooltip_style.shadow_color = Color(COLOR_CYAN.r, COLOR_CYAN.g, COLOR_CYAN.b, 0.6)
	tooltip_style.shadow_size = 15
	tooltip_panel.add_theme_stylebox_override(\"panel\", tooltip_style)
	
	var tooltip_margin := MarginContainer.new()
	tooltip_margin.add_theme_constant_override(\"margin_left\", 15)
	tooltip_margin.add_theme_constant_override(\"margin_right\", 15)
	tooltip_margin.add_theme_constant_override(\"margin_top\", 10)
	tooltip_margin.add_theme_constant_override(\"margin_bottom\", 10)
	tooltip_panel.add_child(tooltip_margin)
	
	tooltip_label = Label.new()
	tooltip_label.add_theme_color_override(\"font_color\", COLOR_CYAN)
	tooltip_label.add_theme_font_size_override(\"font_size\", 14)
	tooltip_label.autowrap_mode = TextServer.AUTOWRAP_WORD
	tooltip_label.custom_minimum_size = Vector2(300, 0)
	tooltip_margin.add_child(tooltip_label)
	
	# Ajouter le tooltip à la racine de la scène avec call_deferred
	get_tree().root.add_child.call_deferred(tooltip_panel)
	
	# Enregistrer les items avec hover
	register_hover_item(weapon_value, weapon_description)
	register_hover_item(hp_badge, hp_description)
	register_hover_item(xp_badge, xp_description)
	register_hover_item(dmg_badge, dmg_description)
	register_hover_item(harvest_badge, harvest_description)

func register_hover_item(item: Control, description: String):
	hover_items[item] = description
	item.mouse_filter = Control.MOUSE_FILTER_PASS
	item.mouse_entered.connect(func(): _on_item_hover_entered(item))
	item.mouse_exited.connect(func(): _on_item_hover_exited(item))

func _on_item_hover_entered(item: Control):
	current_hover_item = item
	
	# Animation de scale avec effet bounce
	var tween := create_tween()
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_BACK)
	tween.tween_property(item, \"scale\", Vector2(1.1, 1.1), 0.3)
	
	# Effet de glow en changeant la modulation
	var glow_tween := create_tween()
	glow_tween.tween_property(item, \"modulate\", Color(1.2, 1.2, 1.2, 1.0), 0.2)
	
	# Afficher le tooltip
	if hover_items.has(item):
		tooltip_label.text = hover_items[item]
		
		# Capturer la position de la souris au moment du hover
		tooltip_fixed_position = get_viewport().get_mouse_position() + Vector2(tooltip_offset_x, tooltip_offset_y)
		
		tooltip_panel.visible = true
		tooltip_panel.position = tooltip_fixed_position

func _on_item_hover_exited(item: Control):
	if current_hover_item == item:
		current_hover_item = null
	
	# Animation de retour
	var tween := create_tween()
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_BACK)
	tween.tween_property(item, \"scale\", Vector2(1.0, 1.0), 0.3)
	
	# Retour à la couleur normale
	var glow_tween := create_tween()
	glow_tween.tween_property(item, \"modulate\", Color(1.0, 1.0, 1.0, 1.0), 0.2)
	
	# Cacher le tooltip
	tooltip_panel.visible = false

func apply_threat_style():
	var threat_style := StyleBoxFlat.new()
	threat_style.bg_color = Color.TRANSPARENT
	
	var threat_color: Color
	var threat_text: String
	
	match threat_level:
		0: # Insignificant
			threat_color = COLOR_GREEN
			threat_text = \"INSIGNIFIANT\"
		1: # Surveillance
			threat_color = COLOR_YELLOW
			threat_text = \"SURVEILLANCE\"
		2: # Classified
			threat_color = COLOR_RED
			threat_text = \"🔒 CONFIDENTIEL\"
	
	threat_style.border_color = threat_color
	threat_style.border_width_left = 2
	threat_style.border_width_right = 2
	threat_style.border_width_top = 2
	threat_style.border_width_bottom = 2
	threat_badge.add_theme_stylebox_override(\"panel\", threat_style)
	
	threat_label.text = threat_text
	threat_label.add_theme_color_override(\"font_color\", threat_color)

func update_values():
	operator_name_label.text = operator_name
	bio_label.text = operator_bio
	weapon_value.text = base_weapon
	hp_value.text = \"%d HP\" % max_hp
	xp_value.text = \"× %.1f\" % xp_multiplier
	dmg_value.text = \"× %.1f\" % damage_multiplier
	harvest_value.text = \"× %.1f\" % harvest_multiplier

func _process(delta: float):
	time += delta
	
	# Animation scan line
	scan_position += delta * 100
	if scan_position > $MainContainer.size.y:
		scan_position = 0
	scan_line.position.y = scan_position
	
	# Pulse effect for classified threat level
	if threat_level == 2:
		glow_intensity = (sin(time * 3.0) + 1.0) / 2.0
		var pulse_color = COLOR_RED.lerp(Color.WHITE, glow_intensity * 0.3)
		threat_label.add_theme_color_override(\"font_color\", pulse_color)
"

