[sub_resource type="GDScript" id="GDScript_1ajci"]
script/source = "extends Button

# Chemin vers le fichier de ressource PlayerData
@export_file(\"*.tres\") var player_data_path: String = \"\"

# Référence au profil d'opérateur (à assigner dans l'éditeur ou via code)
@export var operator_profile: Control

# Mesh parent où afficher le modèle 3D
@export var mesh_parent: Node3D

# Scène du modèle 3D à instancier
@export_file(\"*.tscn\", \"*.scn\") var model_scene_path: String = \"\"

# Nom unique du node créé (pour éviter les doublons)
var model_node_name: String = \"X681_Liberty\"

func _ready():
	pressed.connect(_on_button_pressed)

func _on_button_pressed():
	if player_data_path.is_empty():
		push_error(\"Aucun chemin de ressource défini pour ce bouton!\")
		return
	
	# Vérifier si la référence existe
	if not operator_profile:
		push_error(\"Operator_profile n'est pas assigné!\")
		return
	
	# Vérifier si la méthode existe
	if not operator_profile.has_method(\"load_player_data\"):
		push_error(\"Le node operator_profile n'a pas la méthode load_player_data! Type du node: \" + str(operator_profile.get_class()))
		return
	
	# Charger les données du profil
	operator_profile.load_player_data(player_data_path)
	print(\"Données chargées depuis: \" + player_data_path)
	
	# Gérer le modèle 3D si configuré
	if mesh_parent and not model_scene_path.is_empty():
		_handle_3d_model()
	
	PlayerManager.set_player_selected(model_scene_path, player_data_path)

func _handle_3d_model():
	# Chercher si un node avec ce nom existe déjà
	var existing_node = mesh_parent.get_node_or_null(model_node_name)
	
	if existing_node:
		# Le node existe déjà, cacher tous les autres enfants
		for child in mesh_parent.get_children():
			if child != existing_node:
				child.visible = false
			else:
				child.visible = true
		print(\"Modèle existant affiché: \" + model_node_name)
	else:
		# Le node n'existe pas, le créer
		var model_scene = load(model_scene_path)
		if not model_scene:
			push_error(\"Impossible de charger la scène du modèle: \" + model_scene_path)
			return
		
		var model_instance = model_scene.instantiate()
		model_instance.name = model_node_name
		
		# Positionner à y+1 par rapport au parent
		if model_instance is Node3D:
			model_instance.position.y += 1.0
		
		# Ajouter au mesh parent
		mesh_parent.add_child(model_instance)
		
		# Cacher tous les autres enfants
		for child in mesh_parent.get_children():
			if child != model_instance:
				child.visible = false
		
		print(\"Nouveau modèle créé et affiché: \" + model_node_name)
"

