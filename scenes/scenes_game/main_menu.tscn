[sub_resource type="GDScript" id="GDScript_7b55j"]
script/source = "extends Button

# Chemin vers la scène à charger
@export_file(\"*.tscn\", \"*.scn\") var target_scene_path: String = \"\"

func _ready():
	pressed.connect(_on_button_pressed)

func _on_button_pressed():
	if target_scene_path.is_empty():
		push_error(\"Aucune scène cible définie pour ce bouton!\")
		return
	
	# Vérifier que la scène existe
	if not ResourceLoader.exists(target_scene_path):
		push_error(\"La scène n'existe pas: \" + target_scene_path)
		return
	
	# Changer de scène
	if(PlayerManager.player_skin and PlayerManager.player_data_path):
		get_tree().change_scene_to_file(target_scene_path)
"

