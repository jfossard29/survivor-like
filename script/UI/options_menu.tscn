[sub_resource type="GDScript" id="GDScript_jk1qb"]
script/source = "extends HSlider

const BUS_NAME := \"Music\"
const MUTE_DB := -80.0
const CONFIG_PATH := \"user://settings.cfg\"

@export var label: Label

func _ready() -> void:
	min_value = 0
	max_value = 100
	step = 1
	
	# ✅ Charger la valeur depuis le fichier config
	var loaded_value = _load_volume_from_config()
	
	# Si aucune valeur dans le config, lire depuis le bus
	if loaded_value < 0:
		var bus_idx: int = AudioServer.get_bus_index(BUS_NAME)
		var bus_db: float = AudioServer.get_bus_volume_db(bus_idx)
		var linear: float
		if bus_db <= -79.9:
			linear = 0.0
		else:
			linear = db_to_linear(bus_db)
		value = int(round(linear * 100.0))
	else:
		# Utiliser la valeur du config
		value = loaded_value
		print(\"🎚️ Slider chargé depuis config: \", value, \"%\")
	
	connect(\"value_changed\", Callable(self, \"_on_value_changed\"))
	_update_label(value)
	
	# Appliquer la valeur initiale au bus
	_on_value_changed(value)

func _load_volume_from_config() -> float:
	var config = ConfigFile.new()
	var error = config.load(CONFIG_PATH)
	
	if error != OK:
		print(\"⚠️ Slider: Pas de config trouvée\")
		return -1.0  # Indique qu'il n'y a pas de valeur
	
	if config.has_section_key(\"audio\", \"music_volume\"):
		var volume = config.get_value(\"audio\", \"music_volume\")
		
		# Si c'est déjà un pourcentage (0-100), le retourner
		if volume >= 0 and volume <= 100:
			return volume
		
		# Si c'est en dB (-80 à 0), convertir en pourcentage
		if volume < 0:
			var linear = db_to_linear(volume)
			return linear * 100.0
	
	return -1.0

func _on_value_changed(value: float) -> void:
	var linear: float = clamp(value / 100.0, 0.0, 1.0)
	var db: float = MUTE_DB if linear <= 0.0 else linear_to_db(linear)
	
	# Appliquer au bus
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index(BUS_NAME), db)
	
	_update_label(value)

func _update_label(value: float) -> void:
	if label:
		label.text = \"%d%%\" % int(value)
"

