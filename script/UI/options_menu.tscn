[sub_resource type="GDScript" id="GDScript_jk1qb"]
script/source = "extends HSlider

const BUS_NAME := \"Music\"
const MUTE_DB := -80.0  # silence

@export var label: Label

func _ready() -> void:
	min_value = 0
	max_value = 100
	step = 1

	var bus_idx: int = AudioServer.get_bus_index(BUS_NAME)
	var bus_db: float = AudioServer.get_bus_volume_db(bus_idx)

	var linear: float
	if bus_db <= -79.9:
		linear = 0.0
	else:
		linear = db_to_linear(bus_db)

	value = int(round(linear * 100.0))
	connect(\"value_changed\", Callable(self, \"_on_value_changed\"))

	_update_label(value)

func _on_value_changed(value: float) -> void:
	var linear: float = clamp(value / 100.0, 0.0, 1.0)
	var db: float = MUTE_DB if linear <= 0.0 else linear_to_db(linear)
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index(BUS_NAME), db)
	_update_label(value)

func _update_label(value: float) -> void:
	label.text = \"%d%%\" % int(value)
"

