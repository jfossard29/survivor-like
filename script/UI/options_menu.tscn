[sub_resource type="GDScript" id="GDScript_0axmg"]
script/source = "extends OptionButton

# Dictionnaire des résolutions disponibles
const RESOLUTIONS := {
	0: Vector2i(3840, 2160),
	1: Vector2i(2560, 1440),
	2: Vector2i(1920, 1080),
	3: Vector2i(1600, 900),
	4: Vector2i(1366, 768)
}

const CONFIG_PATH := \"user://settings.cfg\"

func _ready() -> void:	
	# Charger la résolution sauvegardée
	_load_resolution()
	
	# Connecter le signal de changement
	item_selected.connect(_on_item_selected)

func _load_resolution() -> void:
	\"\"\"Charge la résolution depuis le fichier config\"\"\"
	var config = ConfigFile.new()
	var error = config.load(CONFIG_PATH)
	
	if error != OK:
		# Pas de config, détecter la résolution actuelle
		_detect_current_resolution()
		return
	
	if config.has_section_key(\"graphics\", \"resolution_index\"):
		var saved_index = config.get_value(\"graphics\", \"resolution_index\")
		selected = saved_index
		print(\"🖥️ Résolution chargée: index \", saved_index)
	else:
		_detect_current_resolution()

func _detect_current_resolution() -> void:
	\"\"\"Détecte quelle résolution correspond à la fenêtre actuelle\"\"\"
	var current_size = DisplayServer.window_get_size()
	
	for index in RESOLUTIONS:
		if RESOLUTIONS[index] == current_size:
			selected = index
			print(\"🖥️ Résolution détectée: \", current_size)
			return
	
	# Par défaut, sélectionner 1920x1080 (index 2)
	selected = 2

func _on_item_selected(index: int) -> void:
	\"\"\"Appelé quand l'utilisateur change la résolution\"\"\"
	if not RESOLUTIONS.has(index):
		push_error(\"❌ Index de résolution invalide: \", index)
		return
	
	var new_resolution = RESOLUTIONS[index]
	
	# Changer la taille de la fenêtre
	DisplayServer.window_set_size(new_resolution)
	
	# Centrer la fenêtre
	var screen_size = DisplayServer.screen_get_size()
	var window_pos = (screen_size - new_resolution) / 2
	DisplayServer.window_set_position(window_pos)
	
	print(\"✅ Résolution changée: \", new_resolution.x, \"x\", new_resolution.y)

func save_resolution() -> void:
	\"\"\"Sauvegarde la résolution actuelle dans le fichier config\"\"\"
	var config = ConfigFile.new()
	
	# Charger le fichier existant
	config.load(CONFIG_PATH)
	
	# Sauvegarder l'index sélectionné
	config.set_value(\"graphics\", \"resolution_index\", selected)
	
	# Optionnel: sauvegarder aussi la résolution exacte
	var resolution = RESOLUTIONS[selected]
	config.set_value(\"graphics\", \"resolution_width\", resolution.x)
	config.set_value(\"graphics\", \"resolution_height\", resolution.y)
	
	var error = config.save(CONFIG_PATH)
	if error == OK:
		print(\"✅ Résolution sauvegardée: index \", selected)
	else:
		push_error(\"❌ Erreur sauvegarde résolution: \", error)
"

[sub_resource type="GDScript" id="GDScript_8ln24"]
script/source = "extends Button

@onready var menu = null
@onready var option: Control = null
var sound_value: HSlider
var bloom_value: CheckButton
var resolution: CheckButton

const CONFIG_PATH = \"user://settings.cfg\"

func _ready():
	self.pressed.connect(_on_button_pressed)
	
	# Chercher depuis le parent de la scène, ça peut être main_menu ou en jeu
	var parent_container = owner.get_parent()
	
	if parent_container:
		menu = parent_container.find_child(\"Menu\", true, false)
		option = parent_container.find_child(\"OptionsMenu\", true, false)
	
	if option:
		sound_value = option.find_child(\"Slider_Music\", true, false)
		bloom_value = option.find_child(\"CheckButton\", true, false)
		resolution = option.find_child(\"OptionButton\", true, false)

func _on_button_pressed():
	_save_settings()

	if menu:
		menu.visible = true
	if option:
		option.visible = false

func _save_settings() -> void:
	var config = ConfigFile.new()
	
	config.load(CONFIG_PATH)
	
	# Sauvegarder le volume de musique
	if sound_value:
		config.set_value(\"audio\", \"music_volume\", sound_value.value)
	
	# Sauvegarder l'état du bloom
	if bloom_value:
		var bloom_enabled = bloom_value.button_pressed
		config.set_value(\"graphics\", \"bloom_enabled\", bloom_enabled)
	
	var error = config.save(CONFIG_PATH)
	if error == OK:
		print(\" Options : Paramètres sauvegardés\")
	else:
		push_error(\" Options : Erreur lors de la sauvegarde: \", error)
"

